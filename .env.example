# =============================================================================
# .env.example — Пример файла с переменными окружения
# =============================================================================
#
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
#
# ВАЖНО: .env файл содержит секреты и НЕ должен коммититься в git!
#
# =============================================================================

# Секретный ключ для аутентификации wrapper'ов на API
# ОБЯЗАТЕЛЬНО замените на случайную строку!
# Можно сгенерировать: openssl rand -hex 32
RCON_SECRET_KEY=your-super-secret-key-here-change-me

# URL WebSocket API
# Для локальной разработки:
API_URL=ws://host.docker.internal:8000/server/rcon/connect

# Для production (замените на реальный адрес):
# API_URL=wss://api.yourdomain.com/server/rcon/connect

# Уровень логирования
# Возможные значения: trace, debug, info, warn, error
LOG_LEVEL=info
