# =============================================================================
# .gitignore для Rust-проекта
# =============================================================================

# Директория сборки Cargo
# Содержит скомпилированные бинари, промежуточные файлы, кэш
/target/

# Файл блокировки зависимостей
# Для библиотек его не коммитят, для приложений — коммитят
# Мы — приложение, так что оставляем (не игнорируем)
# Cargo.lock

# Бэкапы редакторов
*.swp
*.swo
*~
.*.swp

# IDE
.idea/
.vscode/
*.iml

# macOS
.DS_Store

# Логи
*.log

# Переменные окружения (могут содержать секреты!)
.env
.env.local
.env.*.local

# Локальные тестовые файлы
test-output/
tmp/
